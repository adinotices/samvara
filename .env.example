# ── Copy to .env and fill in. Used by the backend container (docker-compose /
#    fly secrets / your process manager). NEVER commit the filled-in .env. ──

# Auth for the API. "token" requires Authorization: Bearer <token> on every
# request (a session token from the OTP flow for user routes; the static
# API_TOKEN for /v1/tick and admin routes only — it grants no "current user",
# see security.py). "none" disables auth (local dev only).
AUTH_MODE=token
# Static token used by the GitHub Actions cron tick (/v1/tick) and as one of
# the two credentials accepted for admin routes (/v1/admin/invites — the
# other being a session belonging to AUTH_EMAIL). Not needed in config.js —
# the browser always authenticates via the OTP flow instead.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# ── Email OTP login ──
# Resend API key (https://resend.com — free tier is sufficient).
RESEND_API_KEY=
# The app owner's address: where "request access" notifications go, who a
# legacy single-tenant database is attributed to on import (see
# scripts/import_legacy_db.py), and who's allowed to manage invites. Always
# allowed to sign in regardless of SIGNUP_MODE.
AUTH_EMAIL=
# From address for login emails. Must be a domain verified in Resend.
EMAIL_FROM=Samvara <noreply@samvara.app>

# "open" (default): any address that completes the OTP flow gets an account.
#   "invite": only AUTH_EMAIL and addresses added via POST /v1/admin/invites
#   can sign in — a first-time verify for anyone else is rejected before a
#   session is issued. Set to "invite" if you need to gate signup again.
SIGNUP_MODE=open

# Comma-separated exact origin(s) the frontend is served from. Required for the
# browser to call the API cross-origin.
ALLOWED_ORIGINS=https://samvara.app

# ── Stripe: THIS IS WHAT MOVES REAL MONEY for every ordinary user. ──
# Charges are billed directly to the user's own card and the funds are kept
# by Samvara — this is the only charge provider the app exposes publicly
# (see app/billing.py). Use a sk_test_... key until you've verified the whole
# flow end to end (Stripe's test/live key split is the dryrun equivalent —
# there's no separate STRIPE_DRYRUN flag), then switch to sk_live_....
STRIPE_SECRET_KEY=
# Publishable key, safe to ship to the client — returned by GET
# /v1/billing/status and used to initialize the Stripe SDK there.
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret for Stripe events (payment_intent.succeeded for SCA/3D
# Secure confirmation). Get this from your Stripe webhook settings.
STRIPE_WEBHOOK_SECRET=

# ── Beeminder: hidden, personal-only charge provider. ──
# Kept working for the app owner's own account (AUTH_EMAIL above) but not
# offered to any other user, in code or in the client UI — see billing.py's
# module docstring for the owner-only gate. Leave unset unless you're the
# owner and want your own commitments charged via Beeminder instead of Stripe.
# Personal auth token from https://www.beeminder.com/api/v1/auth_token.json
BEEMINDER_TOKEN=
# Your Beeminder username (optional but recommended).
BEEMINDER_USER=
# When true, charges go through Beeminder's dryrun flag — the call is made and
# validated but NO money moves. Leave true until you've verified the whole flow
# end to end, then set false to arm real charges.
BEEMINDER_DRYRUN=true

# ── Money safety rails (apply to both Stripe and Beeminder charges) ──
# Reject any charge below this (Beeminder's own floor is $1.00; also used as
# the Stripe-path floor for consistency).
MIN_STAKE=1.00
# Hard server-side cap. Any single charge above this is refused, no matter what
# the client sends. Your circuit breaker against a bug or a bad request.
# Per charge only — nothing caps the aggregate across commitments or time.
MAX_CHARGE_USD=50.00

# Reject a second live slip/miss on the same commitment within this many
# seconds — a double-clicked confirm would otherwise charge the freshly
# re-rung stake too.
LAPSE_DEBOUNCE_S=10

# Hours after a deadline before an unanswered rung auto-charges. Keep in sync
# with GRACE_MS in frontend/api-client.js (24h there).
GRACE_HOURS=24

# A SQLAlchemy database URL, e.g.:
#   postgresql+psycopg://user:password@host:5432/samvara
# THIS IS WHAT PRODUCTION SHOULD SET. Leave unset for local dev / tests, which
# fall back to a SQLite file at SAMVARA_DB below — SQLite's single-writer
# model and lack of real row locking don't hold up multi-tenant, and it's the
# database the money-path row-locking (store.commitment_lock) is a silent
# no-op against. Run `alembic upgrade head` (from backend/) against a fresh
# Postgres database before pointing the app at it.
DATABASE_URL=

# SQLite path, used only when DATABASE_URL is unset. In Docker this is set to
# /data/samvara.db (a mounted volume) regardless of what's here.
SAMVARA_DB=samvara.db

# Only used by deploy/digitalocean/docker-compose.yml, which runs its own
# Postgres container and wires DATABASE_URL to it automatically from this.
# Irrelevant if you point DATABASE_URL at an external managed Postgres instead.
POSTGRES_PASSWORD=
