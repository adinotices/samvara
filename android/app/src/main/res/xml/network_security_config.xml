<?xml version="1.0" encoding="utf-8"?>
<!-- Network security configuration for Samvara.
     Restricts cleartext (HTTP) traffic to localhost only (for development),
     and enforces HTTPS for production API servers. -->
<network-security-config>
    <!-- Allow cleartext only to localhost (127.0.0.1) for local development. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
    <!-- Default policy: only HTTPS. -->
    <default-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust system CAs (default for production). -->
            <certificates src="system" />
        </trust-anchors>
    </default-config>
</network-security-config>
